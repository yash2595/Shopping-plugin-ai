# Application Environment (development, test, production)
ENV=development
# Production requires explicit opt-in for the anonymous demo registration route.
ALLOW_ANONYMOUS_REGISTRATION=false
# Optional verified API access tokens. Dedicated API audience; public keys only.
# oidc disables anonymous registration even outside production.
AUTH_MODE=anonymous
AUTH_ISSUER=
AUTH_AUDIENCE=
# JWKS object with public RSA >=2048-bit RS256 or P-256 ES256 keys and unique kid/alg.
# Keep current+next public key during rotation, then restart all API processes.
AUTH_JWKS_JSON=

# Pooled Database URL (used by FastAPI runtime)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/shopping

# Direct Database URL (used by Alembic for schema migrations)
DIRECT_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/shopping

# Test Database URL (must end with _test; used by pytest)
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/shopping_test

# Internal Maintenance Job Secret
JOB_SECRET=dev-job-secret-token
# ENV=production requires a separately generated secret of at least 32 characters.

# AI Provider Configuration ('mock' | 'gemini')
AI_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=5
AI_MAX_CONCURRENT_CALLS=8

# Integrated shopping_ai runtime (install the local ai/ package alongside backend/).
AI_RUNTIME_ENABLED=true
AI_RUNTIME_PROVIDER=mock
AI_CORE_TIMEOUT_SECONDS=30
AI_MAX_STEPS=8
AI_MAX_SNAPSHOT_AGE_SECONDS=120
AI_SEARCH_TIMEOUT_SECONDS=120
AI_RUNTIME_TIMEOUT_SECONDS=90
# Explicit packaged-adapter origins only. Fake origin below is for the synthetic HTTP demo.
AI_BROWSER_ORIGINS=["https://demo.shop.test"]
# Keep false until a trusted visible adapter is integrated. Enable for synthetic demo/tests only.
AI_MUTATIONS_ENABLED=false
AI_SEARCH_STORES=[]
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_SPEECH_CALLS_PER_USER_PER_DAY=100

# Optional compatible model/speech endpoints. Empty settings make no external calls.
AI_CHAT_ENDPOINT=
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
AI_STT_ENDPOINT=
AI_STT_MODEL=
AI_STT_API_KEY=
AI_TTS_ENDPOINT=
AI_TTS_MODEL=
AI_TTS_API_KEY=
AI_TTS_VOICE=
AI_TTS_FORMAT=mp3
