# Copy to .env for your local setup, then export/load it explicitly.
# The library intentionally does not load .env files on import.
AI_PROVIDER=mock
# For real Gemini calls: install the [gemini] extra, select gemini above,
# set a model available in your account and export a server-only API key.
# AI_MODEL=your-supported-model-id
# GEMINI_API_KEY=replace-locally-never-commit

# Optional limits (validated; these defaults apply when omitted):
# AI_TIMEOUT_SECONDS=30
# AI_MAX_CONTEXT_CHARS=24000
# AI_MAX_SNAPSHOT_AGE_SECONDS=120
# AI_MAX_STEPS=8
# AI_MAX_OUTPUT_TOKENS=1000
# AI_MAX_CONCURRENT_CALLS=8
# AI_CAPACITY_WAIT_SECONDS=2
